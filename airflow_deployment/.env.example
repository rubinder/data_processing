# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# AWS Resources (from CloudFormation outputs)
EMR_CLUSTER_ID=j-XXXXXXXXXXXXX
S3_LANDING_BUCKET=data-processing-landing-123456789012
S3_PROCESSED_BUCKET=data-processing-processed-123456789012

# Airflow Admin Credentials
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Data-aware scheduling / quality checks (impression_quality_checks DAG)
SPARK_MODE=local
FRESHNESS_SLA_MINUTES=90
VOLUME_BASELINE_DAYS=7

# OpenLineage -> Marquez (see ../lineage_deployment/LINEAGE.md).
# Set OPENLINEAGE_DISABLED=false and the URL to turn lineage on; the same
# OPENLINEAGE_URL is read by the Spark jobs (utils/session.py) and dbt-ol.
OPENLINEAGE_DISABLED=true
OPENLINEAGE_URL=http://marquez-api:5000
OPENLINEAGE_NAMESPACE=data_processing
