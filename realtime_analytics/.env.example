# Copy to .env (or export) to point the pipeline at a different environment.
# Defaults match docker-compose.yaml, so nothing here is required locally.

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:19092
EVENTS_TOPIC=conversation.events
CONSUMER_GROUP=clickhouse-sink
FLINK_CONSUMER_GROUP=flink-conversation-events

# --- ClickHouse --------------------------------------------------------------
ANALYTICS_BACKEND=http          # http | chdb (chdb = embedded, no server)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8125
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_JDBC_URL=jdbc:clickhouse://analytics-clickhouse:8123/default
EVENTS_TABLE=conversation_events
MINUTE_AGG_TABLE=conversation_minute_agg

# --- API ---------------------------------------------------------------------
MAX_LOOKBACK_DAYS=90
MAX_LOOKBACK_HOURS=720

# --- Flink tuning ------------------------------------------------------------
# Every value here is explained in README.md ("Flink tuning"). They are
# environment variables specifically so a job can be retuned without a rebuild.
FLINK_PARALLELISM=4
FLINK_SINK_PARALLELISM=2
FLINK_CHECKPOINT_INTERVAL_MS=30000
FLINK_CHECKPOINT_MIN_PAUSE_MS=10000
FLINK_CHECKPOINT_TIMEOUT_MS=120000
FLINK_TOLERABLE_CP_FAILURES=3
FLINK_UNALIGNED_CHECKPOINTS=true
FLINK_STATE_BACKEND=rocksdb     # rocksdb | hashmap
FLINK_INCREMENTAL_CHECKPOINTS=true
FLINK_CHECKPOINT_DIR=file:///tmp/flink-checkpoints
FLINK_MAX_OUT_OF_ORDERNESS_S=30
FLINK_SOURCE_IDLE_TIMEOUT_MS=60000
FLINK_WINDOW_MINUTES=1
FLINK_MINI_BATCH=true
FLINK_MINI_BATCH_LATENCY_MS=1000
FLINK_MINI_BATCH_SIZE=20000
FLINK_TWO_PHASE_AGG=true
FLINK_RESTART_ATTEMPTS=10
FLINK_RESTART_DELAY_MS=10000
